# Copie este arquivo para .env e preencha. O .env nunca deve ser compartilhado.

# YouTube Data API v3 (garimpo). Opcional: sem ela o garimpo usa yt-dlp (grátis, mais lento).
YOUTUBE_API_KEY=

# Narração: preencha a do provedor escolhido em config.yaml > narracao.provedor.
ELEVENLABS_API_KEY=
# Google Cloud Text-to-Speech. Vazia = usa a YOUTUBE_API_KEY (ative a API no mesmo projeto).
GOOGLE_API_KEY=

# Instagram (publicar Reels). App da Meta + token do Explorador da Graph API (CLAUDE.md > Conexões).
# O token é trocado uma vez por um token da Página que não expira (credenciais/instagram.json).
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_TOKEN=

# TikTok (envia para os rascunhos do app). App em developers.tiktok.com (CLAUDE.md > Conexões).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
